PORT=8080
APP_ENV=development

# ── DB ──────────────────────────────────────────────────────────────
# Local:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_study_tool?sslmode=disable
# Production (Secret Manager で管理 / APP_ENV=production では sslmode=require 必須):
# Cloud Run からは必ず -pooler 付き URL (PgBouncer経由) を使うこと
# DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/DB?sslmode=require
FIREBASE_CREDENTIALS_PATH=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GEMINI_API_KEY=
USE_GEMINI_MOCK=false
GEMINI_TIMEOUT_SECONDS=90
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_DELAY_MS=1500
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_SECONDS=1800
DB_CONN_MAX_IDLE_SECONDS=300
QUESTION_SYNC_PER_TRIGGER_LIMIT=30
QUESTION_SYNC_DAILY_LIMIT=100
QUESTION_SYNC_STALE_PROCESSING_SECONDS=600
QUESTION_SYNC_WORKER_TIMEOUT_SECONDS=120
QUESTION_WORKER_POLL_INTERVAL_SECONDS=600
HIGHLIGHT_INGEST_DAILY_LIMIT=100

# ── Stripe ──────────────────────────────────────────────────────────
# 機密値は Secret Manager で管理（ローカルのみここに設定）
STRIPE_SECRET_KEY=sk_test_YOUR_TEST_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_LOCAL_WEBHOOK_SECRET
# 非機密値は GitHub Actions vars で管理
STRIPE_PRICE_ID_MONTHLY=price_XXXXXXXXXX
STRIPE_SUCCESS_URL=http://localhost:3000/billing/success
STRIPE_CANCEL_URL=http://localhost:3000/billing/cancel
